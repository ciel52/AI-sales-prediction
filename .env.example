# コピーして使う: cp .env.example .env
# `.env` に実キーを書き、API を再起動する。

# 使うLLM: auto | gemini | openai
# auto = Geminiキーがあれば Gemini、なければ OpenAI
LLM_PROVIDER=auto

# Google AI Studio で発行: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# OpenAI（任意）
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 生の購買履歴（CSPM buying_history の TSV/CSV）。未指定時は
# test_data/buying_data/buying_history.csv を探す。
# RAW_BUYING_PATH=/path/to/buying_history.csv
